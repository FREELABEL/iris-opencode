{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "The iPhone build (#194511): no shell, updater, process or window state.",
  "platforms": [
    "iOS"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "iris-web-auth:default",
    "opener:default",
    "store:default",
    "os:default",
    "notification:default",
    "clipboard-manager:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        },
        {
          "url": "http://*:*/*"
        }
      ]
    }
  ]
}
