<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- macOS will not even SHOW the microphone prompt without a usage string; the app is
         terminated instead. Worded for the person reading the dialog, and it is accurate:
         dictation is transcribed by the bundled iris-cli on this machine. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>IRIS uses your microphone for dictation. Recordings are transcribed on this Mac and are never uploaded.</string>
</dict>
</plist>
